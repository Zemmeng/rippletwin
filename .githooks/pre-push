#!/usr/bin/env bash
# .githooks/pre-push -- last local gate before a push: no direct pushes to main; push only the current HEAD;
# no push unless the check is green
#
# What it does: covers three things that branch protection would otherwise handle --
#       [1] target is refs/heads/main (including deleting main) and ALLOW_MAIN=1 is not set → refuse and suggest
#           a branch first
#       [2] the commit being pushed is not the current HEAD → refuse and suggest switching to that branch first
#           (check.sh inspects the current worktree, so pushing another branch would push it unchecked)
#       [3] runs BRANCH=<pushed branch> CHECK_TEST_TIMEOUT=70 bash scripts/check.sh --quick (90 s overall limit)
#           any ❌, or a missing "======== Summary" line → refuse and print the summary block
#           the per-test limit is 20 s shorter than the overall one: a hanging test is reported as [5] ❌ by the
#           check before the overall timeout below would let the push through
#           script missing → ⚠️ allow; overall timeout → ⚠️ allow (CI runs the full check)
# When it runs: automatically on git push (requires git config core.hooksPath .githooks; setup.sh does this).
#       git passes one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>
# How to bypass:
#       a small maintainer change pushed straight to main: ALLOW_MAIN=1 git push   (give the reason in the commit)
#       skip the hook entirely in an emergency: git push --no-verify   (explain it in the PR; CI still checks)
# Exit codes: 0 allow; 1 refuse
# Works with macOS's bundled bash 3.2 (no timeout command: run in the background and poll with kill -0) and Ubuntu.
set -uo pipefail

LIMIT_S=90
ZERO=0000000000000000000000000000000000000000

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0

head_sha=$(git rev-parse -q --verify HEAD 2>/dev/null || true)
cur_branch=$(git symbolic-ref --short -q HEAD 2>/dev/null || true)

# ---- Read stdin: which refs are being pushed ----
to_main=0
has_update=0
not_head=""
push_branch=""
while read -r lref lsha rref rsha; do
  [ -n "${rref:-}" ] || continue
  [ "$rref" = "refs/heads/main" ] && to_main=1
  case "${lsha:-}" in
    "$ZERO"|"") continue ;;   # deleting a remote ref: no new code to check
  esac
  has_update=1
  # an annotated tag sha is the tag object; peel it to the commit before comparing
  commit=$(git rev-parse -q --verify "${lsha}^{commit}" 2>/dev/null || echo "$lsha")
  if [ "$commit" != "$head_sha" ]; then
    not_head="$not_head    $lref → $rref
"
  fi
  if [ -z "$push_branch" ]; then
    case "$lref" in
      refs/heads/*) push_branch=${lref#refs/heads/} ;;
      *) push_branch=$cur_branch ;;          # git push origin HEAD / pushing a tag: use the current branch name
    esac
    if [ -z "$push_branch" ]; then
      case "$rref" in refs/heads/*) push_branch=${rref#refs/heads/} ;; esac
    fi
  fi
done

# ---- [1] No direct pushes to main ----
if [ "$to_main" -eq 1 ] && [ "${ALLOW_MAIN:-}" != "1" ]; then
  echo "🚫 pre-push: no direct pushes to main. Create a branch, push it, then open a PR:"
  echo "    git switch -c <handle>/<module>/T<n>-<slug>"
  echo "    git push -u origin HEAD"
  echo "    gh pr create --fill"
  echo "  For a small maintainer change that really must go straight to main: ALLOW_MAIN=1 git push   (give the reason in the commit)"
  exit 1
fi

[ "$has_update" -eq 1 ] || exit 0

# ---- [2] Push only the current HEAD ----
if [ -n "$not_head" ]; then
  echo "🚫 pre-push: the commit being pushed is not the current HEAD (currently on ${cur_branch:-detached HEAD})."
  echo "  The check only inspects the current worktree, so another branch would be pushed unchecked. Refused:"
  printf '%s' "$not_head"
  echo "  Switch to that branch and push from there:"
  echo "    git switch <branch> && git push -u origin HEAD"
  echo "  (git push --all or push.default=matching, which push several branches at once, are refused too; push them one at a time)"
  exit 1
fi

# ---- [3] check.sh --quick, 90 s overall limit ----
if [ ! -f scripts/check.sh ]; then
  echo "⚠️ pre-push: scripts/check.sh not found, check skipped (push allowed)"
  exit 0
fi

test_timeout=$((LIMIT_S - 20))
[ "$test_timeout" -ge 10 ] || test_timeout=10

out=$(mktemp "${TMPDIR:-/tmp}/pre-push-check.XXXXXX") || { echo "⚠️ pre-push: mktemp failed, check skipped (push allowed)"; exit 0; }
trap 'rm -f "$out"' EXIT

echo "⏳ pre-push: BRANCH=${push_branch:-(unknown)} bash scripts/check.sh --quick (at most ${LIMIT_S} s overall, ${test_timeout} s per test)"
# set -m: run check.sh in its own process group so a timeout also kills the test processes it started
set -m
BRANCH="$push_branch" CHECK_TEST_TIMEOUT="$test_timeout" bash scripts/check.sh --quick </dev/null >"$out" 2>&1 &
pid=$!
set +m

# print new output every second, so a long check still shows progress
shown=0
waited=0
timed_out=0
flush_new() {
  local n
  n=$(wc -l <"$out" | tr -d ' ')
  if [ "${n:-0}" -gt "$shown" ]; then
    sed -n "$((shown + 1)),${n}p" "$out"
    shown=$n
  fi
}
# when the job is killed on timeout, bash prints a "Terminated" job notice to stderr: silence stderr while polling and reaping
exec 3>&2 2>/dev/null
while kill -0 "$pid"; do
  if [ "$waited" -ge "$LIMIT_S" ]; then
    timed_out=1
    kill -TERM -- "-$pid" || kill -TERM "$pid"
    sleep 1
    kill -KILL -- "-$pid"
    break
  fi
  sleep 1
  waited=$((waited + 1))
  flush_new
done
wait "$pid"
code=$?
exec 2>&3 3>&-
flush_new
# wc -l does not count a final line without a newline, so print it once more
if [ -s "$out" ] && [ -n "$(tail -c 1 "$out")" ]; then
  tail -n 1 "$out"; echo ""
fi

if [ "$timed_out" -eq 1 ]; then
  echo "⚠️ pre-push: check.sh --quick took longer than ${LIMIT_S} s and was stopped; allowing this push (CI runs the full check; run bash scripts/check.sh --quick locally to see which step is slow)"
  exit 0
fi

summary=$(grep -E '^======== Summary' "$out" | tail -n 1)
nfail=$(printf '%s\n' "$summary" | sed -nE 's/^======== Summary ([0-9]+) ❌.*/\1/p')

if [ -z "$summary" ] || [ "$code" -ne 0 ] || [ "${nfail:-1}" != "0" ]; then
  echo ""
  echo "🚫 pre-push: the check failed, push refused. Summary block:"
  echo "----------------------------------------"
  if [ -n "$summary" ]; then
    # check.sh's summary block = the summary line + every ❌/⚠️ line repeated verbatim
    sed -n '/^======== Summary/,$p' "$out"
  else
    echo "(check.sh printed no \"======== Summary\" line, exit code $code -- it most likely crashed; treated as a failure)"
  fi
  echo "----------------------------------------"
  echo "  Full output: logs/last-check.txt"
  echo "  Fix it and push again; in an emergency use git push --no-verify, but explain it in the PR -- CI still checks."
  exit 1
fi

echo "✅ pre-push: check passed"
exit 0
