#!/usr/bin/env bash
# .githooks/pre-commit -- fast gate before each commit: secrets, secret files, large files
#
# What it does: every local commit passes this gate, with or without AI tools.
#       [1] bash scripts/secret-scan.sh --staged (script missing → ⚠️ and let the commit through)
#       [2] staged .env / .dev.vars / settings.local.json / keys.json (and similar) → blocked
#       [3] any staged file > 1 MB → blocked (compress it, or host it elsewhere and link it from a README);
#           .json data files under apps/<module>/public/ may be up to 2 MB (matches the PRD's "each file < 2 MB")
#           .pdf files under docs/hackathon/pitch/ may be up to 10 MB (the submitted pitch PDFs)
# When it runs: automatically on git commit, once the hooks are enabled:
#       git config core.hooksPath .githooks   (bash scripts/setup.sh does this for you)
# How to bypass: in an emergency, git commit --no-verify. CI runs scripts/check.sh again; explain why in the PR.
# Exit codes: 0 allow; 1 block
# Works with macOS's bundled bash 3.2 and on Ubuntu.
set -uo pipefail

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0

MAX_BYTES=1048576        # 1 MB
MAX_DATA_BYTES=2097152   # 2 MB: .json under apps/<module>/public/
DATA_RE='^apps/[^/]+/public/.+\.json$'
MAX_PDF_BYTES=10485760   # 10 MB: .pdf under docs/hackathon/pitch/
PDF_RE='^docs/hackathon/pitch/.+\.pdf$'
fail=0
scan_failed=0
bad_secret_files=""
bad_big_files=""

echo "🔍 pre-commit: secret scan / secret files / large files"

# ---- [1] Secret scan ----
if [ -f scripts/secret-scan.sh ]; then
  if bash scripts/secret-scan.sh --staged; then
    echo "[1] Secret scan ✅"
  else
    echo "[1] Secret scan ❌ the staged content looks like it contains a key / token (only file:line:pattern is listed above; values are never printed)"
    scan_failed=1
    fail=1
  fi
else
  echo "[1] Secret scan ⚠️ scripts/secret-scan.sh not found, skipped (commit allowed)"
fi

# ---- [2] Secret files + [3] large files: only added / modified / renamed files (deleting is the fix, never blocked) ----
while IFS= read -r -d '' f; do
  base=${f##*/}
  case "$base" in
    *.example) ;;  # .env.example / .dev.vars.example list variable names only, allowed
    .env|.env.*|.dev.vars|.dev.vars.*|settings.local.json|keys.json|credentials*.json|*.pem|*.key)
      bad_secret_files="$bad_secret_files    $f
" ;;
  esac
  size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
  limit=$MAX_BYTES; limit_name=1MB
  if [[ $f =~ $DATA_RE ]]; then limit=$MAX_DATA_BYTES; limit_name=2MB; fi
  if [[ $f =~ $PDF_RE ]]; then limit=$MAX_PDF_BYTES; limit_name=10MB; fi
  if [ "${size:-0}" -gt "$limit" ] 2>/dev/null; then
    kb=$((size / 1024))
    bad_big_files="$bad_big_files    ${f} (${kb}KB > ${limit_name})
"
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ -n "$bad_secret_files" ]; then
  echo "[2] Secret files ❌ these files never go into git:"
  printf '%s' "$bad_secret_files"
  fail=1
else
  echo "[2] Secret files ✅"
fi

if [ -n "$bad_big_files" ]; then
  echo "[3] Large files ❌ files over the size limit (2 MB for .json under apps/<module>/public/, 10 MB for .pdf under docs/hackathon/pitch/, 1 MB otherwise):"
  printf '%s' "$bad_big_files"
  fail=1
else
  echo "[3] Large files ✅"
fi

[ "$fail" -eq 0 ] && exit 0

# ---- Blocked: print the fixes ----
echo ""
echo "🚫 Commit blocked. To fix:"
if [ -n "$bad_secret_files" ]; then
  echo "  · Secret files: git rm --cached <file>   (removes it from the index only; the local file stays)"
  echo "    Make sure .gitignore covers it; keep values in .env or a password manager, and list variable names only in example files"
fi
if [ -n "$bad_big_files" ]; then
  echo "  · Large files: git restore --staged <file>"
  echo "    Convert images to webp / compress them (commit only web-sized versions); host videos and originals elsewhere and link them from the module README"
  echo "    Keep raw material in raw/ or assets-src/ (already gitignored)"
fi
if [ "$scan_failed" -eq 1 ]; then
  echo "  · Secret scan hit: remove the value from that line and read it from an environment variable instead; for a false positive, rewrite the line or add a whitelist rule to secret-scan.sh"
  echo "    If the key was ever committed (even unpushed): rotate the key first, then decide whether to clean the history"
fi
echo ""
echo "  In an emergency, git commit --no-verify skips this hook, but CI checks again and the PR must explain why."
exit 1
