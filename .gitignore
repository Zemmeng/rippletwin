# This repository holds source code, docs, configuration and small compressed assets only; secrets, dependencies,
# large files and generated output stay out. Never force-add an ignored file with git add -f.

# ---- Secrets and local configuration (never committed; values live in a password manager, example files list names only) ----
.env
.env.*
!.env.example
.dev.vars
**/.dev.vars
!**/.dev.vars.example
*.pem
*.key
keys.json
credentials*.json
.claude/settings.local.json

# ---- Local AI tool output (agent scratch files; safe to delete once merged into docs) ----
.claude/agent-out/
# Temporary worktrees of AI coding sessions; if not ignored, check [3] reports them as cross-module changes
.claude/worktrees/

# ---- Dependencies ----
node_modules/
.venv/
__pycache__/
*.pyc

# ---- Platform caches and build output (the .wrangler cache was committed by mistake once) ----
.wrangler/
dist/
build/
.cache/

# ---- Large media and generated output (originals and screen recordings are hosted elsewhere; commit web-sized versions only) ----
raw/
out/
assets-src/
art-src/
candidates/
*.mp4
*.mov
*.wav
*.zip

# ---- Data and logs (sample data goes in fixtures/; large datasets are hosted elsewhere) ----
data/
*.sqlite
*.sqlite3
*.db
*.parquet
logs/
*.log

# ---- Personal drafts ----
scratch/

# ---- OS and editor files ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
