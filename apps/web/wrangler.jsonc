// Legacy standalone Cloudflare config for apps/web: a static page served from public/ with assets only, no Worker code,
// no bindings. Production does not use it: apps/site serves this page at /web/public/ next to the engine, data and API.
// A standalone copy has no engine or data behind it: it shows the engine-offline card over a procedural city. Deploy it with
// bash scripts/deploy.sh web (DEPLOYER only), which runs npm run deploy in this directory.
{
  "name": "rippletwin",               // Worker name = workers.dev subdomain prefix: rippletwin.<account subdomain>.workers.dev
  "compatibility_date": "2026-08-01",
  "workers_dev": true,                // kept on during the hackathon for a demo link
  "preview_urls": false,
  "assets": { "directory": "public" }
  // To bind a custom domain, uncomment and set your own hostname:
  // "routes": [{ "pattern": "rippletwin.example.com", "custom_domain": true }]
}
