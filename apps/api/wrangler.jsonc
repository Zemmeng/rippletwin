// Cloudflare Worker config. Two Durable Objects: LlmBudget enforces the daily LLM call cap, WorksiteRegister stores the worksite register
// Deployed by the DEPLOYER (hackathon.conf): bash scripts/deploy.sh all deploys this Worker first, then site (site forwards /api/* here through the API service binding)
// 🔒 The key is never written here: npx wrangler secret put LLM_API_KEY (run in this directory). To enable the LLM, see the README section "Status and re-enabling the LLM"; deployment: docs/architecture/deployment.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name = services[].service in apps/site/wrangler.jsonc; rename both together (checked by config.test.mjs).
  // Named hackathon-api rather than api to avoid clashing with other projects in the same Cloudflare account
  "name": "hackathon-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",

  // No hackathon-api.<subdomain>.workers.dev: traffic comes in only through the site service binding (which does not need that URL), so there is one less public entry point
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },

  // Static files under public/ (reader.js, rules.js, answers/); any path worker.js does not handle goes here
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },

  "vars": {
    // The LLM is called only when this is "0" and LLM_API_KEY is set; otherwise keyword rules (/api/health shows llm.mode rules)
    // D-0929-2307: LLM enabled (sign reading + plan explanation). Emergency stop without editing this file: npx wrangler secret delete LLM_API_KEY
    // After the event the LLM_API_KEY secret was deleted, so production runs in rules mode with MOCK still "0"
    "MOCK": "0",
    // OpenAI-compatible POST {LLM_BASE_URL}/chat/completions. To switch provider, change these two lines and the key:
    //   DeepSeek (default)          https://api.deepseek.com                              deepseek-flash
    //   DashScope (international)   https://dashscope-intl.aliyuncs.com/compatible-mode/v1  qwen-plus (or qwen-flash)
    //   DashScope (mainland China)  https://dashscope.aliyuncs.com/compatible-mode/v1       qwen-plus
    //   OpenAI                      https://api.openai.com/v1                              gpt-4o-mini
    "LLM_BASE_URL": "https://api.deepseek.com",
    "LLM_MODEL": "deepseek-flash",
    // Max calls per Worker instance per minute (best effort, not a billing cap); one demo page is about 20 requests × 3 = 60
    // D-1001-0125: raised to 600 during the event (10x one demo page, so live sign editing and explanations at 5 each never hit it)
    "LLM_MAX_CALLS_PER_MIN": "600",
    // Max global calls per day (BUDGET counter shared by all instances, reset at 00:00 UTC); past the cap only the rules run for the day.
    // D-1001-0125: effectively uncapped during the event (DeepSeek balance about ¥100) → 50000 calls (about ¥0.002 each ≈ ¥100); the real limit was the provider balance, and when it runs out DeepSeek errors and the rules take over
    // Restore a real cap (for example "600" per day and "60" per minute) before re-enabling the LLM
    "LLM_MAX_CALLS_PER_DAY": "50000"
  },

  // BUDGET: daily LLM call counter (src/budget.js); REGISTER: worksite register (src/register.js)
  // The free plan only allows the SQLite backend → new_sqlite_classes; deployed tags must never change: a new class needs a new tag, a renamed class a new tag + renamed_classes
  "durable_objects": {
    "bindings": [
      { "name": "BUDGET", "class_name": "LlmBudget" },
      { "name": "REGISTER", "class_name": "WorksiteRegister" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LlmBudget"] },
    { "tag": "v2", "new_sqlite_classes": ["WorksiteRegister"] }
  ]

  // Reading cache shared across visitors and instances (one write per new reading). During the event (from 2026-09-30) the account was on Workers Paid, so KV writes were billed monthly
  // instead of the free plan's 1,000 a day; rules mode makes no KV writes. Without KV only the per-instance memory cache is left: the site is on *.workers.dev, where the
  // built-in Cache API does nothing (/api/health would show llm.cache memory). To recreate: npx wrangler kv namespace create READINGS in this directory, then put the new id below
  ,"kv_namespaces": [{ "binding": "READINGS", "id": "f1729ac78da649198d3e1f5d41e30956" }]
}
