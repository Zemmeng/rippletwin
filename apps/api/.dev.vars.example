# wrangler dev reads .dev.vars in this directory, not .env: cp .dev.vars.example .dev.vars
# 🔒 .dev.vars is gitignored; this example holds only variable names and placeholder values. Production secrets use npx wrangler secret put <NAME>
# 1 = no LLM calls, keyword rules only (/api/health returns "mock":true, llm.mode "rules"); a real call happens only with 0 and an LLM_API_KEY
MOCK=1
# LLM key (the same variable name for DeepSeek / DashScope / any OpenAI-compatible provider). Put the value only in your local .dev.vars, never in the repo
LLM_API_KEY=
# If unset, the vars in wrangler.jsonc apply (DeepSeek: https://api.deepseek.com + deepseek-flash); to switch provider, see the README section "LLM integration"
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
