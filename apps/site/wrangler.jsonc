// site: one Worker serves every module. /<module>/public/... is an unchanged copy of each module's public/ (build.mjs copies it to out/);
// /api/sumo/* goes to hackathon-sumo and every other /api/* to the API Worker (hackathon-api)
// Deploy only through bash scripts/deploy.sh all, which runs npm run deploy = node build.mjs && wrangler deploy
// No secrets here: the LLM key is set on the API Worker with npx wrangler secret put <NAME>. See README.md and docs/architecture/deployment.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker name = workers.dev URL prefix: https://hackathon-site.<account subdomain>.workers.dev
  // Renaming it changes the public URL; update DEMO_URL in hackathon.conf to match
  "name": "hackathon-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  // Serves the demo URL; set to false and redeploy to take the public URL down (docs/decisions.md D-10)
  "workers_dev": true,
  // No per-version preview URLs: fewer unmanaged, publicly reachable entry points
  "preview_urls": false,
  // Live console.log output and errors: Workers Logs in the Cloudflare dashboard, or npx wrangler tail
  "observability": { "enabled": true },

  "assets": {
    // build.mjs output (gitignored), not source; npm run dev / deploy regenerate it first
    "directory": "out",
    "binding": "ASSETS",
    // /api/* runs the Worker first (/api/sumo/* to hackathon-sumo, the rest to hackathon-api); /api/public/* are static files from
    // apps/api/public/ (reader.js and so on) and stay with static assets. worker.js has the same exclusion: change both together
    "run_worker_first": ["/api/*", "!/api/public/*"]
  },

  // ---- API: service = "name" in apps/api/wrangler.jsonc (rename both together; tests/config.test.mjs checks it) ----
  // hackathon.conf has DEPLOY_MODULES=api site: api must come first, because a binding's target Worker has to exist,
  // otherwise the deploy fails with Could not resolve service binding
  // ---- SUMO: /api/sumo and /api/sumo/* go to hackathon-sumo (apps/sumo, Cloudflare Container); worker.js checks it before /api/* ----
  // service = "name" in apps/sumo/wrangler.jsonc (tests/config.test.mjs checks it). hackathon-sumo had to exist before site was deployed;
  // it was deployed by hand from a machine with Docker (cd apps/sumo && npx wrangler deploy), so DEPLOY_MODULES deliberately leaves sumo out.
  // ⚠️ Post-event: hackathon-sumo has been deleted. Remove the SUMO binding below before the next site deploy (worker.js then returns
  // 503 sumo_off and the page keeps using the pre-computed results), and relax tests/config.test.mjs and apps/sumo/tests/config.test.mjs with it
  "services": [
    { "binding": "API", "service": "hackathon-api" },
    { "binding": "SUMO", "service": "hackathon-sumo" }
  ]
}
