// sumo: Worker hackathon-sumo + Cloudflare Container (live SUMO, D-0930-1700)
// Deployed only by the lead from their own machine, with Docker running in colima: cd apps/sumo && npx wrangler deploy (README.md, deployment).
// Deliberately not in DEPLOY_MODULES in hackathon.conf: deploy.sh all would fail on a machine without Docker.
// The site forwards /api/sumo/* here over the SUMO service binding; this Worker must exist before the site's SUMO binding is deployed,
// otherwise the site deploy fails with "Could not resolve service binding".
// Post-event: this Worker and its container were deleted after the hackathon; the file is kept so the service can be redeployed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // = the SUMO service in apps/site/wrangler.jsonc services (rename both together)
  "name": "hackathon-sumo",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  // no hackathon-sumo.<subdomain>.workers.dev: the only entry point is the site service binding (same origin, no CORS)
  "workers_dev": false,
  // no separate preview URL for each uploaded version
  "preview_urls": false,
  // production logs (container start / stop, forwarding errors) are in Workers Logs on the Cloudflare dashboard, or npx wrangler tail hackathon-sumo
  "observability": { "enabled": true },

  // Container: the image is the Dockerfile, the build context is apps/ (the Dockerfile COPYs web/tools/sumo/… and the roads/public/cbd/*.json the real network needs)
  // standard-4 = 4 vCPU / 12 GiB / 20 GB disk (the Cloudflare container maximum): for the full hour each scenario runs its own SUMO process in parallel (SUMO_REAL_JOBS=4);
  // one vCPU needs about 1.5 minutes per run. The lead chose the upgrade on 1 Oct with a total budget of US$20 (memory is billed while awake, about US$1.5–3 to the end of judging)
  // max_instances 1: serve.py's job state lives only in this one instance (worker.js always uses getContainer(…, 'main'))
  "containers": [
    {
      "class_name": "SumoContainer",
      "image": "./Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-4",
      "max_instances": 1
    }
  ],

  // The container class is itself a Durable Object: binding SUMO_CONTAINER (read by worker.js), class = SumoContainer exported from worker.js
  "durable_objects": {
    "bindings": [
      { "name": "SUMO_CONTAINER", "class_name": "SumoContainer" }
    ]
  },
  // Declares the Durable Object class on first deploy (containers need a SQLite-backed DO); a deployed tag cannot change, so add v2 for any new class
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SumoContainer"] }
  ],

  // At most 3 POST /runs per IP (CF-Connecting-IP) per minute; period can only be 10 or 60. namespace_id is any positive integer unique within the account
  // This limit is counted per Cloudflare location and eventually consistent, not exact; the busy gate backs it up (≥ 2 jobs in the container → 429)
  "ratelimits": [
    { "name": "SUMO_RL", "namespace_id": "3501", "simple": { "limit": 3, "period": 60 } }
  ]
}
