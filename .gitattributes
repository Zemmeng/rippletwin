# Normalise line endings to LF: a .sh file or hook saved with CRLF on Windows fails with "bad interpreter"
* text=auto eol=lf
*.sh text eol=lf
.githooks/* text eol=lf

# Append-only logs use the union merge driver: concurrent appends at the end keep both sides, with no conflict markers.
# ⚠️ union applies only to a local git merge; GitHub's web conflict editor ignores it -- resolve conflicts locally
#    with git merge origin/main.
# ⚠️ union suits one-entry-per-line files only; never use it on tables with headers or on code.
docs/decisions.md merge=union
docs/pitfalls.md merge=union

# Binary files: no line-ending conversion, no text diff
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.pdf binary
*.mp3 binary
*.woff binary
*.woff2 binary

# GitHub Linguist: keep generated files and the event archive out of the language statistics
apps/web/public/index.html linguist-generated
apps/sumo/public/** linguist-generated
docs/hackathon/** linguist-documentation
